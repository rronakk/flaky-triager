{
  "name": "flaky-triager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "parse": "tsx src/cli.ts parse",
    "score": "tsx src/cli.ts score",
    "analyze": "tsx src/cli.ts analyze",
    "report": "tsx src/cli.ts report",
    "history": "tsx src/cli.ts history",
    "filter-junit": "tsx src/cli.ts filter-junit",
    "bundle:action": "esbuild src/action.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/action.cjs"
  },
  "bin": {
    "flaky-triager": "./dist/cli.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.99.0",
    "adm-zip": "^0.5.17",
    "fast-xml-parser": "^5.8.0",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
